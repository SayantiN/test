  this.SaveItineraryDetailsToLocalDB = function (view, itineraryNo) {
    var db = new PouchDB('myAppDb');
    var ItineraryDetail = null;
    var itineraryNoVersion = itineraryNo + "_" + $("#PublishVersion").val();
    db.get(itineraryNoVersion).then(function (ItineraryDetail) {
      me.SaveAllObjectsToLocalDb(db, ItineraryDetail, itineraryNo, false);
    }).catch(function (err) {
      ItineraryDetail = {
        _id: itineraryNoVersion,
        Version: $("#PublishVersion").val(),
        CoverLetter: null,
        Itinerary: null,
        Accommodation: null,
        Notes: null,
        Specialists: null,
        Cost: null,
        Flight: null,
        TourLeader: null,
        QuickItinerary: null,
        Map: null,
        TourHighLights: null
      }
      me.SaveAllObjectsToLocalDb(db, ItineraryDetail, itineraryNo, true);
    });

    this.SaveAllObjectsToLocalDb = function (db, ItineraryDetail, itineraryNo, pushalldata) {
      me.PushItineraryToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata);
    }
  }

  this.PushItineraryToLocalObject = function (db, ItineraryDetail, itineraryNo, pushalldata) {
    $.ajax({
      cache: false,
      async: false,
      url: hostURL + "Itinerary/ItineraryViewContent",
      data: { ItineraryNo: itineraryNo, publishVersion: parseInt($("#PublishVersion").val()) || 0 },
      success: function (resultJson) {
        if (resultJson != undefined && resultJson != ItineraryDetail.Itinerary) {
          ItineraryDetail.Itinerary = resultJson;
          pushalldata = true;
        }
        me.PushAccomodationToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      },
      error: function (msg) {
        // me.PushAccomodationToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      }
    });
  }

