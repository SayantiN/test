  this.OpenGeneratePDFPage = function (printSize, companyCode, printOldItinInd, itineraryNoPrint, isConsultant, isPDFWithImage) {
    var url = '';
    var itineraryNo = $("#itineraryNoPrint").val();
    var publishVersion = parseInt($("#PublishVersion").val()) || 0;
    if (itineraryNoPrint) {
      itineraryNo = itineraryNoPrint;
    }
    var printOldItin = false;
    if (printOldItinInd) {
      printOldItin = printOldItinInd
    }

    var showOptimisedImgInd = false;
    if (isConsultant) {
      showOptimisedImgInd = isConsultant
    }

    if ((companyCode.toString().toUpperCase() == "RSUS" || companyCode.toString().toUpperCase() == "ITUK" || companyCode.toString().toUpperCase() == "WFUK" || companyCode.toString().toUpperCase() == "ECUK")
      && isPDFWithImage == undefined) {
      isPDFWithImage = true;
    }

    if (!myAccountCommon.isNullOrEmpty(companyCode) && companyCode.toString().toUpperCase() == "STUK") {
      url = hostURL + "common/pdfFormatV1?itinearyNo=" + itineraryNo + "::" + printSize + "&PrintOldFormat=" + printOldItin;
    }
    else if (!myAccountCommon.isNullOrEmpty(companyCode) && companyCode.toString().toUpperCase() == "HAUK") {
      url = hostURL + "common/pdfFormatV1_HA?itinearyNo=" + itineraryNo + "::" + printSize + "&PrintOldFormat=" + printOldItin;
    }
    else if (!myAccountCommon.isNullOrEmpty(companyCode) && companyCode.toString().toUpperCase() == "LTUK") {
      url = hostURL + "common/pdfFormatV1?itinearyNo=" + itineraryNo + "::" + printSize;
    }
    else if (!myAccountCommon.isNullOrEmpty(companyCode) && companyCode.toString().toUpperCase() == "BTUK") {
      url = hostURL + "common/pdfFormatV1?itinearyNo=" + itineraryNo + "::A5:" + showOptimisedImgInd + "&PrintOldFormat=" + printOldItin;
    }
    else if (!myAccountCommon.isNullOrEmpty(companyCode) && (companyCode.toString().toUpperCase() == "FCUK"
      || companyCode.toString().toUpperCase() == "CLUK") || companyCode.toString().toUpperCase() == "RSUS"
      || companyCode.toString().toUpperCase() == "ITUK" || companyCode.toString().toUpperCase() == "ASUK"
      || companyCode.toString().toUpperCase() == "RMSA" || companyCode.toString().toUpperCase() == "SQUK"
      || companyCode.toString().toUpperCase() == "WFUK" || companyCode.toString().toUpperCase() == "CEUS" || companyCode.toString().toUpperCase() == "ECUK") {
      url = hostURL + "common/pdfFormatV1?itinearyNo=" + itineraryNo + "::" + printSize + ":" + showOptimisedImgInd + "&PrintOldFormat=" + printOldItin + "&PrintWithImg=" + isPDFWithImage;
    }
    else {
      url = hostURL + "common/pdfFormatV1?itinearyNo=" + itineraryNo + "::" + printSize + ":" + showOptimisedImgInd + "&PrintOldFormat=" + printOldItin + "&publishVersion=" + publishVersion;
    }
    window.open(url, '_blank');
    $("#GeneratePDFConfirmation").modal("hide");
  }

  this.SavePageBreakXmlAndDwnldGrpItin = function (genericTourCode, DepDate, actualItinNo) {
    var customWindow = window.open("");
    var PagebreakDivIdList = [];
    var RemoveImgDivIdList = [];
    $('input[type=checkbox]:checked').each(function () {
      PagebreakDivIdList.push($(this).attr('data-val'));
    });
    $('span[id^="Img_"][class="img_shwblk01 red"]').each(function () {
      RemoveImgDivIdList.push($(this).attr('id'));
    });
    try {
      console.log('pdf print start');
      customWindow.document.write('<h2>We\'re just preparing your itinerary….</h2>');
      $.ajax({
        cache: false,
        url: hostURL + "Common/mydhruvtourpdfprocess",
        data: {
          Id: genericTourCode + "|" + DepDate,
          ItineraryNo: actualItinNo
        },
        success: function (result) {
          if (result != 'undefined' && result.openPdfPath != 'undefined') {
            console.log(result.openPdfPath);
            customWindow.location = result.openPdfPath;
          }
        },
        error: function (msg) {
          console.log('pdf print start : error');
          $("p").html("Something went wrong!! please try again.");
          $("img").hide();
          console.log(msg);
        }
      });
    }
    catch (ex) {
      console.log('pdf print start :catch : error');
      $("p").html("Something went wrong please try again.");
      $("img").hide();
      console.log(ex);
    }
  }

