  this.UploadDocument = function () {
    var fileupload = $('#fileupload')[0].files[0];
    var fileuploadName = $('#fileupload')[0].files[0].name;
    var formData = new FormData();
    formData.append('file', $('#fileupload')[0].files[0]);

    var input = document.getElementById('fileupload');
    console.log(input.files);
    $.ajax({
      cache: false,
      async: false,
      type: "post",
      url: hostURL + "Common/UploadDocument",
      data: {
        file: fileuploadName
      },
      beforeSend: function () {
        $("#uploadLoader").html('<img  alt="" src=' + hostURL + 'images/ajax-loader.gif></img>').show();
      },
      success: function (resultJson) {
        $('#uploadLoader').html('');
        $('#uploadLoader').html("Uploaded Document successfully").show();
      },
      error: function (msg) {
        $("#uploadLoader").html(MyAccountConstants.GenericErrorMsg);
      }
    });
  }

  this.UploadDocumentValidation = function (event) {
    if ($("#hdndocumentType").val() == undefined || myAccountCommon.isNullOrEmpty($("#hdndocumentType").val())) {
      $("#validatemsg").show();
      $("#validatemsg").html("Please select document type");
      event.preventDefault();
      return false;
    }

    if ($("#hdnnotes").val() == undefined || myAccountCommon.isNullOrEmpty($("#hdnnotes").val())) {
      $("#validatemsg").show();
      $("#validatemsg").html("Please enter notes");
      event.preventDefault();
      return false;
    }
    return true;
  }

  this.DownloadLink = function (link, id) {
    var iframeID = id + "downloadFrame";
    var loadHtml = hostURL + 'images/ajax-loader.gif';
    $('#' + iframeID).show();
    $('#' + iframeID).height('0');
    $('#' + iframeID).css('opacity', '0')
    //$('#' + iframeID).attr('src', loadHtml);
    $('#' + iframeID).attr('src', link);
    //$('#' + iframeID).hide();
    setTimeout(function () {
      //var htmlContent = $('#' + iframeID).contents().find('html');
      //$('#' + iframeID).contents().find('html').val()
      $('#' + iframeID).hide();
      $('#' + iframeID).attr('src', '');
    }, 2000);
    //$('#' + iframeID).on("load", function () {
    //  alert('load over');
    //});
  }

  this.OpenContactTravelExpert = function (travelID) {
    var itineraryName = $('#ItinearyName p').html();
    $.ajax({
      cache: false,
      async: false,
      url: hostURL + "Common/OpenContactTravelExpert",
      data: {
        itineraryName: itineraryName,
        travelID: travelID
      },
      beforeSend: function () {
        $("#ContactTravelExpert").html('<img  alt="" src=' + hostURL + 'images/ajax-loader.gif></img>');
      },
      success: function (resultJson) {
        $('#ContactTravelExpert').html('');
        $('#ContactTravelExpert').html(resultJson);
      },
      error: function (msg) {
        $("#ContactTravelExpert").html(MyAccountConstants.GenericErrorMsg);
      }
    });
  }

  this.SendEmailToTravelExpert = function () {
    if (CheckValidEmail() && CheckTravelexpertSubject() && CheckTravelExpertContent()) {
      $("#ContactExpertPreloader").show();
      try {
        $.ajax({
          cache: false,
          type: "post",
          url: hostURL + "Common/SendEmailTravelExpert",
          data: {
            emailSubject: $('#SubjectName').val(),
            emailTo: $('#ClientEmailaddress').html(),
            emailContent: $('#EmailMailContent').val(),
            sendCopy: $('#chkCopyEmailToMe').prop("checked")
          },
          success: function (result) {
            $("#ContactExpertPreloader").hide();
            if (result.Status) {
              $("#msgDisplaySendMailSuccess").text(MyAccountConstants.ContactTravelExpertSuccessMsg);
              $("#msgDisplaySendMailSuccess").show();
              setTimeout(function () {
                $("#msgDisplaySendMailSuccess").hide(); $("#msgDisplaySendMailSuccess").text('');
              }, 3000);
            }
            else {
              $("#msgDisplaySendMailError").text(MyAccountConstants.ContactTravelExpertErrorMsg);
              $("#msgDisplaySendMailError").show();
              setTimeout(function () {
                $("#msgDisplaySendMailError").hide();
              }, 3000);
            }
          },
          error: function (msg) {
            if (!myAccountCommon.isNullOrEmpty($.trim(msg.responseText))) {
              if (msg.responseText.match('Error has occured') != null && msg.responseText.match('Error has occured').length > 0) {
                myAccountCommon.RedirectToUrl('', 'Account/Error');
              }
              else {
                $("#ContactExpertPreloader").hide();
                console.log(msg);
                $("#msgDisplaySendMailError").text(MyAccountConstants.ContactTravelExpertErrorMsg);
                $("#msgDisplaySendMailError").show();
                setTimeout(function () {
                  $("#msgDisplaySendMailError").hide();
                  $("#msgDisplaySendMailError").text('');
                }, 3000);
              }
            }
          }
        });
      }
      catch (ex) {
        $("#ContactExpertPreloader").hide();
        console.log(ex);
      }
    }
  }

  function CheckValidEmail() {
    var emailList = [];
    if (!myAccountCommon.isNullOrEmpty($('#ClientEmailaddress').html())) {
      emailList = $("#ClientEmailaddress").html().split(';');
      if (emailList.length > 0) {
        for (var i = 0; i < emailList.length; i++) {
          if (!myAccountCommon.IsEmail(emailList[i])) {
            $("#msgDisplaySendMailError").html(MyAccountConstants.ValidEmailId).show();
            setTimeout(function () {
              $("#msgDisplaySendMailError").hide();
            }, 3000);
            return false;
            break;
          }
        }
      }
    }
    else {
      $("#msgDisplaySendMailError").html(MyAccountConstants.EnterEmailId).show();
      setTimeout(function () {
        $("#msgDisplaySendMailError").hide();
      }, 3000);
      return false;
    }
    return true;
  }

  function CheckTravelexpertSubject() {
    if (myAccountCommon.isNullOrEmpty($('#SubjectName').val())) {
      $("#msgDisplaySendMailError").html(MyAccountConstants.ContactTravelExpertSubject).show();
      setTimeout(function () {
        $("#msgDisplaySendMailError").hide();
      }, 3000);
      return false;
    }
    return true;
  }

  function CheckTravelExpertContent() {
    if (myAccountCommon.isNullOrEmpty($('#EmailMailContent').val())) {
      $("#msgDisplaySendMailError").html(MyAccountConstants.ContactTravelExpertMailContent).show();
      setTimeout(function () {
        $("#msgDisplaySendMailError").hide();
      }, 3000);
      return false;
    }
    return true;
  }

