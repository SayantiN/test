          ItineraryDetail = doc;
          $('.viewall_btnblk').show();
          $("#ItinImageReplacedContent").show();
          $("#ReplacedContent").html('');

          $('.viewall_btnblk').hide();
          $("#ItinImageReplacedContent").hide();
          $('#ReplacedContent').html('');
          $('#ReplacedContent').show();
          switch (view) {
            case "Itinerary":
              $('#ReplacedContent').html(ItineraryDetail.Itinerary);
              break;
            case "Accommodation":
              $('#ReplacedContent').html(ItineraryDetail.Accommodation);
              break;
            case "Notes":
              $('#ReplacedContent').html(ItineraryDetail.Notes);
              break;
            case "Cost":
              $('#ReplacedContent').html(ItineraryDetail.Cost);
              break;
            case "CoverLetter":
              $('#ReplacedContent').html(ItineraryDetail.CoverLetter);
              break;
            case "Flight":
              $('#ReplacedContent').html(ItineraryDetail.Flight);
              break;
            case "Specialists":
              $('#ReplacedContent').html(ItineraryDetail.Specialists);
              break;
            case "TourLeader":
              $('#ReplacedContent').html(ItineraryDetail.TourLeader);
              break;
            case "QuickItinerary":
              $('#ReplacedContent').html(ItineraryDetail.QuickItinerary);
              break;
            case "TourHighLights":
              $('#ReplacedContent').html(ItineraryDetail.TourHighLights);
              break;
          }

          $('.hdsgnpg_rtnvlst').find('li').each(function () {
            $(this).removeClass('cur');
          });
          $("#" + view + "Tab").parent().addClass('cur');

          $('#ddlListTab').find('option').each(function () {
            $(this).removeClass('selected');
          });
          $("#ddl" + view).addClass('selected');
          myAccountCommon.ToggleItinDetils();
        }).catch(function (err) {
        });
      }
    }
    catch (ex) {
      $("#ItinImageReplacedContent").hide();
      $('.viewall_btnblk').hide();
    }
  }

  this.ShowPredepartureInfo = function (id) {
    var selectedTab = $('#ddlListCoun option:selected').val();
    $(".InfoByCount").hide() //hide all div
    $("#" + selectedTab + ".InfoByCount").show();
    $(".tab_nav_title").hide();
  }

  this.ViewChangeOnDropdown = function () {
    var selectedOption = $('#ddlListTab option:selected');
    //var selectedTextTab = $('#ddlListTab option:selected').text();
    var selectedTab = selectedOption.val();                
    var isDocument = selectedOption.data('type');         

    var ItineraryNo = $("#ItineraryNo").val();
    var DecryptedItinNo = $("#DecryptedItinNo").val();
    var whySteppesLink = $("#whySteppesLink").val();
    var travelAppLink = $("#travelAppLink").val();
    var visaData = $("#visaData").val();
    var OnlinePaymentLink = $("#OnlinePaymentLink").val();
    var PTQLink = $("#PTQLink").val();
    var atolDownloadLink = $("#atolDownloadLink").val();
    var invoiceDownloadLink = $("#invoiceDownloadLink").val();
    var Documents = $("#ddlDocuments").attr('name');
    var OBFLink = $("#OBFLink").val();

    if (isDocument === "document") {
      var downloadUrl = selectedTab; 
      var docId = selectedOption.data('id');
      console.log("Downloading:", downloadUrl);

      isgItinerary.DownloadLink(downloadUrl, docId);
      return; 
    }


    if (selectedTab == "CoverLetter" || selectedTab == "Introduction")
      isgItinerary.ReplacedViewContent('CoverLetter', ItineraryNo)
    else if (selectedTab == "Specialists")
      isgItinerary.ReplacedViewContent('Specialists', ItineraryNo)
    //else if (selectedTab == "Cost")
    //  isgItinerary.ReplacedViewContent('Cost', ItineraryNo)
    else if (selectedTab == "Cost")
      isgItinerary.ReplacedViewContent('Cost', ItineraryNo)
    else if (selectedTab == "Flight")
      isgItinerary.ReplacedViewContent('Flight', ItineraryNo)
    else if (selectedTab == "Accommodation")
      isgItinerary.ReplacedViewContent('Accommodation', ItineraryNo)
    else if (selectedTab == "TourLeader")
      isgItinerary.ReplacedViewContent('TourLeader', ItineraryNo)
    else if (selectedTab == "Notes")
      isgItinerary.ReplacedViewContent('Notes', ItineraryNo)
    else if (selectedTab == "Map")
      isgItinerary.ReplacedViewContent('Map', ItineraryNo)
    else if (selectedTab == "TourHighLights")
      isgItinerary.ReplacedViewContent('TourHighLights', ItineraryNo)
    else if (selectedTab == "Itinerary")
      isgItinerary.ReplacedViewContent('Itinerary', ItineraryNo)
    else if (selectedTab == "Document")
      isgItinerary.ReplacedViewContent('Document', ItineraryNo)

    else if (selectedTab == "WhySteppes") {
      window.location.href = whySteppesLink;
    }
    else if (selectedTab == "VISAInformation") {
      window.location.href = visaData;
    }
    else if (selectedTab == "TravelAppLink") {
      window.location.href = travelAppLink;
    }
    else if (selectedTab == "OnlinePayment") {
      window.location.href = OnlinePaymentLink;
    }
    else if (selectedTab == "BookingForm") {
      window.location.href = OBFLink;
    }
    else if (selectedTab == "Invoice") {
      isgItinerary.DownloadLink(invoiceDownloadLink, 'invoice')
    }
    else if (selectedTab == "ATOLCertificate") {
      isgItinerary.DownloadLink(atolDownloadLink, 'atol')
    }
    else if (selectedTab == "PostTravelQuestionnaire") {
      window.location.href = PTQLink;
    }
    else if (selectedTab == "DownloadAndPrintItin") {
      isgItinerary.SavePageBreakXmlAndDwnldItinInMobileView(DecryptedItinNo, false, '', '', '', '', '', true)
    }
    else if (Documents == "Documents") {
      window.location.href = selectedTab;
    }
    else
      isgItinerary.ReplacedViewContent(selectedTab, ItineraryNo)
  }

  this.RedirectToAccommodation = function (itineraryNo, hotelCode) {
    isgItinerary.ReplacedViewContentOnMenuSelect('Accommodations', itineraryNo, RedirectToAccommodationFunc);
    function RedirectToAccommodationFunc() {
      setTimeout(function () {
        $('html,body').animate({ scrollTop: $("#accomTab_" + hotelCode).offset().top - 125 }, 'slow');
      }, 1000);
    }
  }

  this.QuotePopup = function (itineraryDetails) {
    var preparedOn = '';
    var preparedFor = '';
    if (itineraryDetails != undefined) {
      preparedOn = myAccountCommon.ParseJsonDateToDateTime(JSON.parse(itineraryDetails).PreparedOn);
      preparedFor = JSON.parse(itineraryDetails).PreparedFor;
      $.ajax({
        cache: false,
        async: false,
        url: hostURL + "Quotes/GetDayWiseItinerary",
        data: { itineraryNo: JSON.parse(itineraryDetails).ItineraryNumber },
        beforeSend: function () {
          $("#quoteModal").html('<img  alt="" src=' + hostURL + 'images/ajax-loader.gif></img>');
        },
        success: function (resultJson) {
          $('#quoteModal').html('');
          $('#quoteModal').html(resultJson);
          if (preparedOn != null && preparedOn != '') {
            $('#quoteModal .quote_infotxt1').html('prepared on ' + myAccountCommon.AppendZero(preparedOn.getDate()) + "." + myAccountCommon.AppendZero((preparedOn.getMonth() + 1)) + "." + preparedOn.getFullYear());
          }
          else {
            $('#quoteModal .quote_infotxt1').html('');
          }
          if (preparedFor != null && preparedFor != '') {
            $('#quoteModal .quote_infotxt2').html('For: ' + preparedFor);
          } else {
            $('#quoteModal .quote_infotxt2').html('');
          }
        },
        error: function (msg) {
          $("#quoteModal").html(MyAccountConstants.GenericErrorMsg);
        }
      });
    }
    else {
      $("#quoteModal").html(MyAccountConstants.NoDetailsFound);
    }
  }

