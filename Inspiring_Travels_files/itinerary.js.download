  this.PushQuickItineraryToLocalObject = function (db, ItineraryDetail, itineraryNo, pushalldata) {
    $.ajax({
      cache: false,
      async: true,
      url: hostURL + "Itinerary/QuickItineraryViewContent",
      data: { ItineraryNo: itineraryNo },
      success: function (resultJson) {
        if (resultJson != undefined && resultJson != ItineraryDetail.QuickItinerary) {
          ItineraryDetail.QuickItinerary = resultJson;
          pushalldata = true;
        }
        me.PushMapToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      },
      error: function (msg) {
        // me.PushMapToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      }
    });
  }

  this.PushMapToLocalObject = function (db, ItineraryDetail, itineraryNo, pushalldata) {
    $.ajax({
      cache: false,
      async: true,
      url: hostURL + "Itinerary/MapViewContent",
      data: { ItineraryNo: itineraryNo },
      success: function (resultJson) {
        if (resultJson != undefined && resultJson != ItineraryDetail.Map) {
          ItineraryDetail.Map = resultJson;
          pushalldata = true;
        }
        me.PushTourHighLightToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      },
      error: function (msg) {
        // me.PushTourHighLightToLocalObject(db, ItineraryDetail, itineraryNo, pushalldata)
      }
    });
  }

  this.PushTourHighLightToLocalObject = function (db, ItineraryDetail, itineraryNo, pushalldata) {
    $.ajax({
      cache: false,
      async: true,
      url: hostURL + "Itinerary/TourHighLightsViewContent",
      data: { ItineraryNo: itineraryNo },
      success: function (resultJson) {
        if (resultJson != undefined && resultJson != ItineraryDetail.TourHighLights) {
          ItineraryDetail.TourHighLights = resultJson;
          pushalldata = true;
        }
        if (pushalldata) {
          db.put(ItineraryDetail);
        }
      },
      error: function (msg) {
        //if (pushalldata) {
        //  db.put(ItineraryDetail);
        //}
      }
    });
  }

  this.GetPreDepartureCountryText = function (textType, itinNo) {
    var counCode = $($(".cntry_info .active")[0]).attr("data-countrycode");
    if (counCode) {
      $('html,body').animate({ scrollTop: $("#" + counCode + " #" + textType).offset().top - 150 }, 'slow');
    }
    else {
      isgItinerary.ChangeImpInfoMenu('CountryInfoMenu', itinNo, GetPreDepartureCountryTextFunction);
      function GetPreDepartureCountryTextFunction() {
        counCode = $($(".cntry_info ul.nav-tabs li")[0]).attr("data-countrycode");
        if (counCode) {
          $('html,body').animate({ scrollTop: $("#" + counCode + " #" + textType).offset().top - 150 }, 'slow');
        }
      }
    }
  }

  this.OpenAccomTabs = function (element, id, hotelCode, itineraryNo) {
    $(element).toggleClass('active');
    if ($('#accomtabs_' + id).html().trim().length > 0) {
      $('#MoreDetails_' + id).toggle(500);
    }
    else {
      $('#accomtabs_' + id).html('<div class="loader_icon" style="background-image: url(' + hostURL + 'Content/BR/Images/UK/loader.svg); width: 100%; height: 200px; background-repeat: no-repeat; background-position: center;"></div>').show();
      $('html,body').animate({ scrollTop: $('#accomtabs_' + id).offset().top - 150 }, 'slow');
      $.ajax({
        cache: false,
        async: true,
        url: hostURL + "Itinerary/GetAccomodationTabDetails",
        data: {
          ItineraryNo: itineraryNo,
          HotelCode: hotelCode,
          Id: id
        },
        success: function (resultJson) {
          if (resultJson != undefined && resultJson != null) {
            $('#accomtabs_' + id).html(resultJson);
            //$('#MoreDetails_' + id).show();
            var selectedRoomType = $('#hdnHotelRmTypeDesc_' + id).val();
            var selectedRoomTypeCode = "";

            if ($("#roomType_" + id).length > 0) {
              $("#roomType_" + id + " option").filter(function () {
                if (this.text == selectedRoomType) {
                  selectedRoomTypeCode = this.value;
                }
              });
            }
            if (!myAccountCommon.isNullOrEmpty(selectedRoomTypeCode)) {
              $("#roomType_" + id).val(selectedRoomTypeCode).trigger("onchange");
            }
            $('#MoreDetails_' + id).toggle(500);
            isgItinerary.initFlexSliders(id);
          }
        },
        error: function (msg) {
          //$('#accomtabs_' + id).html('<img  alt="" src=' + hostURL + 'images/ajax-loader.gif></img>').hide();
          console.log(msg);
        }
      })
    }
  }

  this.initFlexSliders = function (id) {
    $('.accd_slides_' + id).flexslider({
      animation: "slide",
      touch: true,
      directionNav: true,
      isFirefox: true,
      prevText: "",
      nextText: "",
      slideshowSpeed: 7000,
      animationSpeed: 2000,
      itemWidth: 960,
      init: function (slider) {
        // lazy load
        //$("img.lazy").slice(0, 2).each(function () {
        //$(slider).find(".accom-slider-li.flex-active-slide").width(960);
        $(slider).find(".accom-slider-li.flex-active-slide").next().find("img.lazy").slice(0, 2).each(function () {
          var src = $(this).attr("data-src");
          //$(this).parent().width(960);
          if (src) {
            $(this).attr("src", src).removeAttr("data-src").removeClass("lazy");
          }
        });
      },
      start: function (slider) {
        if (slider.itemW != 960) {
          $('.accd_slides_' + id).data('flexslider').resize();
        }
      },
      after: function (slider) {
        if (!slider.playing) {
          slider.play();
        }
      },
      before: function (slider) {
        // lazy load
        if (slider.itemW != 960) {
          $('.accd_slides_' + id).data('flexslider').resize();
        }
        //$("img.lazy").slice(0, 1).each(function () {
        $(slider).find(".accom-slider-li.flex-active-slide").next().find("img.lazy").slice(0, 1).each(function () {
          //if (slider.itemW != 960) {
          //  $(this).parent().width(960);
          //}
          var src = $(this).attr("data-src");
          if (src) {
            $(this).attr("src", src).removeAttr("data-src").removeClass("lazy");
          }
        });
      }
    });

    //$('.accd_slides_' + id).data('flexslider').resize();

  };

  this.loadCompDetails = function (ElementType, id, element, itineraryNo) {
    var CpntType = $("#CpntType").val();
    var CpntCode = id;
    var ElementCode = $('#' + element.id + ' option:selected').val()
    var classname = '';
    //accd_room_txt room_01_86_5485

    if (ElementType.toUpperCase() == "ROOMTYPE") {
      var Id = 'accd_room_txt room_01 ' + CpntCode + ' ' + ElementCode
      classname = '.accd_room_txt';
    }
    if (ElementType.toUpperCase() == "RESTAURANT") {
      var Id = 'restnt_txt rest_01 ' + CpntCode + ' ' + ElementCode
      classname = '.restnt_txt';
    }
    if (ElementType.toUpperCase() == "ACTIVITY") {
      var Id = 'actvty_txt actvt_01 ' + CpntCode + ' ' + ElementCode
      classname = '.actvty_txt';
    }
    $(classname).each(function () {
      //if ($(this).hasClass(CpntCode) && $(this).hasClass(ElementCode)) {
      if ($(this).hasClass(CpntCode)) {
        if ($(this).hasClass(ElementCode)) {
          $(this).show();
        }
        else {
          $(this).hide()
        }
      }
      else {
        // $(this).hide()
      }
    });
  }

  this.SavePageBreakXml = function (itineraryNo, PrintA5Ind, isUpload, BkgNo, PrintOldFormat, branchCode) {
    var PagebreakDivIdList = [];
    var RemoveImgDivIdList = [];
    $('input[type=checkbox]:checked').each(function () {
      PagebreakDivIdList.push($(this).attr('data-val'));
    });
    $('span[id^="Img_"][class="img_shwblk01 red"]').each(function () {
      RemoveImgDivIdList.push($(this).attr('id'));
    });
    var noofNotesPage = !(typeof $('input[name=noofpage]:checked').val() == "undefined") ? $('input[name=noofpage]:checked').val() : "0";
    try {
      $("#btnSavexml").attr("disabled", true)
      $('#popupLoader').show();
      $("#xmlSavedSuccess").hide();
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "Common/SavePageBreakXml",
        data: {
          itinearyNo: itineraryNo,
          pageBreakDivIdList: JSON.stringify(PagebreakDivIdList),
          removeImgDivIdList: JSON.stringify(RemoveImgDivIdList),
          NoofNotePages: noofNotesPage,
          //BkgNo: $("#hiddenBkgNo").val(),
          //QuoteNo: $("#hiddenQuoteNo").val(),
          //AccountNo: $("#hiddenAccountCode").val(),
          //isupload: ($("#isUpload").val() || "false"),
          PrintA5Ind: PrintA5Ind,
          PrintOldFormat: PrintOldFormat,
          //branchCode: branchCode
        },
        success: function (result) {
          $('#popupLoader').hide();
          $("#xmlSavedSuccess").text("Saved successfully").show();
          $("#btnSavexml").attr("disabled", false)
          if (result != undefined) {
            console.log(result);
          }
        },
        error: function (msg) {
          $("#xmlSavedSuccess").hide();
          $("#btnSavexml").attr("disabled", false)
          $('#popupLoader').hide();
          //console.log('pdf print start : error');
          console.log(msg);
        }
      });
    }
    catch (ex) {
      $('#popupLoader').hide();
      // console.log('pdf print start :catch : error');
      console.log(ex);
    }
  }

  this.GenerateOnlinePaymentLinkExternally = function (BkgNo, AccountCode) {
    try {
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "Common/GenerateOnlinePaymentLinkExternally",
        data: {
          bkgNo: BkgNo,
          AcctCode: AccountCode
        },
        success: function (result) {
          window.open(result, '_blank');
        },
        error: function (msg) {
        }
      });
    }
    catch (ex) {
      console.log(ex);
    }
  }

  this.ExportDocument = function (seqNo, documentPath) {
    if (!myAccountCommon.isNullOrEmpty(seqNo)) {
      var url = hostURL + "/Common/ExportDocument?seqNo=" + seqNo;
      window.open(url, "_blank");
    }
    else {
      var url = hostURL + "/Common/ExportDocument?documentPath=" + documentPath;
      window.open(url, "_blank");
    }
  }

  this.changeNotesval = function () {
    var text = $("#txtNotes").val();
    $("#hdnnotes").val(text);
    $("#hdndocumentSubType").val(document.getElementById("docsubtype").value);
  }

  this.DownloadtourPDF = function (itineraryNo) {
    try {
      window.location = hostURL + "Common/PreviewFinalDoc?itineraryNo=" + itineraryNo;
    }
    catch (ex) {
      console.log('pdf print start :catch : error');
      $("p").html("Something went wrong please try again.");
      $("img").hide();
      console.log(ex);
    }
  }

  this.GenerateFinalDocPDF = function () {
    try {
      var BookingNo = $("#BookingNo").val();
      var QuoteNo = $("#QuoteNo").val();
      var ItineraryNo = $("#ItineraryNo").val();
      var PagebreakDivIdList = [];
      $('input[type=checkbox]:checked').each(function () {
        PagebreakDivIdList.push($(this).attr('data-val'));
      });
      $('#popupLoader').show();
      var customWindow = window.open("");
      customWindow.document.write('<h2>PDF is generating</h2>');
      $.ajax({
        cache: false,
        url: hostURL + "Common/GenerateFinalDocPDF",
        type: "POST",
        data: {
          itinearyNo: ItineraryNo,
          bookingNo: BookingNo,
          quoteNo: QuoteNo,
          pageBreakDivIdList: JSON.stringify(PagebreakDivIdList),
        },
        beforeSend: function () {
          $(".loader").html('<img  alt="" src=' + hostURL + 'images/ajax-loader.gif></img>');
        },
        success: function (resultJson) {
          $('#popupLoader').hide();
          if (resultJson != undefined) {
            console.log(resultJson);
            customWindow.location = resultJson;
          }
        },
        error: function (msg) {
          $('#popupLoader').hide();
        }
      });
    }
    catch (ex) {
      $('#popupLoader').hide();
      console.log('pdf print start :catch : error');
      $("p").html("Something went wrong please try again.");
      $("img").hide();
      console.log(ex);
    }
  }

  this.OpenUrlPath = function (Url, FileName) {
    window.open(Url, '_blank');
  }

  this.SavePageBreakXmlAndDwnldItinInMobileView = function (itineraryNo, PrintA5Ind, isUpload, BkgNo, PrintOldFormat, branchCode, isConsultant, IsPDFWithImage) {
    var customWindow = window.open("");
    var ShowAgentPrice = $('#hdnShowAgentPrice').val();
    var PagebreakDivIdList = [];
    var RemoveImgDivIdList = [];
    $('input[type=checkbox]:checked').each(function () {
      PagebreakDivIdList.push($(this).attr('data-val'));
    });
    $('span[id^="Img_"][class="img_shwblk01 red"]').each(function () {
      RemoveImgDivIdList.push($(this).attr('id'));
    });
    var noofNotesPage = !(typeof $('input[name=noofpage]:checked').val() == "undefined") ? $('input[name=noofpage]:checked').val() : "0";
    try {
      console.log('pdf print start');
      $('#popupLoader').show();
      var publishversion = $("PublishVersion").val();
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "Common/pdfV1Convert",
        data: {
          itinearyNo: itineraryNo,
          pageBreakDivIdList: JSON.stringify(PagebreakDivIdList),
          removeImgDivIdList: JSON.stringify(RemoveImgDivIdList),
          NoofNotePages: noofNotesPage,
          BkgNo: $("#hiddenBkgNo").val(),
          QuoteNo: $("#hiddenQuoteNo").val(),
          AccountNo: $("#hiddenAccountCode").val(),
          isupload: ($("#isUpload").val() || "false"),
          PrintA5Ind: PrintA5Ind,
          PrintOldFormat: PrintOldFormat,
          branchCode: branchCode,
          showOptimisedImg: isConsultant,
          showAgentPrice: ShowAgentPrice,
          isPDFWithImage: IsPDFWithImage,
          publishVersion: publishversion
        },
        success: function (result) {
          $('#popupLoader').hide();
          if (result != undefined) {
            console.log(result);
            customWindow.location = result;
          }
        },
        error: function (msg) {
          $('#popupLoader').hide();
          console.log('pdf print start : error');
          console.log(msg);
        }
      });
    }
    catch (ex) {
      $('#popupLoader').hide();
      console.log('pdf print start :catch : error');
      console.log(ex);
    }
  }

  this.loadAnalytics = function (accountCode, quoteNo, bkgNo, itineraryNo, analyticUrl) {
    debugger
    sessionStorage.setItem('account_code', accountCode);
    sessionStorage.setItem('quote_no', quoteNo);
    sessionStorage.setItem('booking_no', bkgNo);
    sessionStorage.setItem('itinerary_no', itineraryNo);
    window.ANALYTICS_CONFIG = {
      TRACKING_SERVER: analyticUrl,
      SITE_ID: 'mydhruv',

      // Maps analytics field name → sessionStorage key used by THIS app
      SESSION_STORAGE_KEYS: {
        account_code: 'account_code',
        booking_no: 'booking_no',
        quote_no: 'quote_no',
        itinerary_no: 'itinerary_no',
      }
    }
  }

}