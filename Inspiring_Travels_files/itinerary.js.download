var isgItinerary = new function () {
  var me = this;

  this.ReplacedViewContent = function (view, itineraryNo, isGroup, ActualViewName) {
    try {
      if (itineraryNo == "") {
        itineraryNo = $('#ItineraryNo').val();
      }
      $("#" + view + "Tab").removeClass('selected');
      $($('#' + view + "Tab").parent()).removeClass("mm-listitem_selected");
      if (view == "Itinerary") {
        $('.img_slider').addClass('main_itinerary');
        //$('.Itineraryheadsntnc').show();
      }
      else {
        $('.img_slider').removeClass('main_itinerary');
        //$('.Itineraryheadsntnc').hide();
      }
      var ViewURL = hostURL + "Itinerary/" + view + "ViewContent";
      var dataParam = { ItineraryNo: itineraryNo, publishVersion: parseInt($("#PublishVersion").val()) || 0 };
      if (!myAccountCommon.isNullOrEmpty(isGroup) && isGroup.toString().toLowerCase() == 'true' && view == 'Itinerary') {
        var genericTourCode = $('#dhruv_analytics_generictourcode').val();
        var depDate = $('#dhruv_analytics_depDate').val();
        ViewURL = hostURL + "Common/ConvertAPItoPDF";
        dataParam = { Id: genericTourCode + "|" + depDate }; //? countrycode = en_gb 
      }

      if (typeof Offline != "undefined" && Offline.state == "up") {
        $.ajax({
          cache: false,
          async: true,
          url: ViewURL,
          data: dataParam,
          beforeSend: function () {
            $('.viewall_btnblk').show();
            $("#ItinImageReplacedContent").show();
            $("#ReplacedContent").html('');
          },
          success: function (resultJson) {
            $('.viewall_btnblk').hide();
            $("#ItinImageReplacedContent").hide();
            $('#ReplacedContent').html('');
            $('#ReplacedContent').show();
            $('#ReplacedContent').html(resultJson);
            $('.no_padding_all.hdsgnpg_rightpnl').removeClass('blk_visible');
            $('.hamburger-mobi-menu').removeClass('open');
            $('.icon-btn').removeClass('show')
            $('html,body').animate({ scrollTop: $("#ReplacedContent").offset().top - 150 }, 'slow');
            $('.hdsgnpg_rtnvlst').find('li').each(function () {
              $(this).removeClass('cur');
            });
            $('.trip__menu').find('li').each(function () {
              $(this).find("a").removeClass('selected');
            })
            //$('#ddlListTab .filter-option').text(me.ActualViewName(view));
            $('#ddlListTab .filter-option').val(me.ActualViewName(view));
            if (ActualViewName != undefined) {
              $('#ddlListTab .filter-option').text(ActualViewName);
            }
            $("#" + view + "Tab").parent().addClass('cur');
            $('.hdsgnpg_rtnvblk').find('li').each(function () {
              $(this).find("a").removeClass('selected');
            });

            $("#" + view + "Tab").addClass('selected');
            $($(".fixed_sidebar").find("#" + view + "Tab")).addClass("selected");

            $('#ddlListTab').find('option').each(function () {
              $(this).removeClass('selected');
            });
            $("#ddl" + view).addClass('selected');
            myAccountCommon.ToggleItinDetils();

            var mmMenu = $("#Tripmenu").data("mmenu");
            if (mmMenu) {
              mmMenu.close();
            }
          },
          error: function (msg) {
            $('#ReplacedContent').html('<center><p>' + MyAccountConstants.GenericErrorMsg + '</p></center>');
            $("#ItinImageReplacedContent").hide();
            $('.viewall_btnblk').hide();
          }
        });
      }
      else {
        var db = new PouchDB('myAppDb');
        var ItineraryDetail = null;
        var itineraryNoVersion = itineraryNo + "_" + $("#PublishVersion").val();
        db.get(itineraryNoVersion).then(function (doc) {
          ItineraryDetail = doc;
          $('.viewall_btnblk').show();
          $("#ItinImageReplacedContent").show();
          $("#ReplacedContent").html('');

          $('.viewall_btnblk').hide();
          $("#ItinImageReplacedContent").hide();
          $('#ReplacedContent').html('');
          $('#ReplacedContent').show();
          switch (view) {
            case "Itinerary":
              $('#ReplacedContent').html(ItineraryDetail.Itinerary);
              break;
            case "Accommodation":
              $('#ReplacedContent').html(ItineraryDetail.Accommodation);
              break;
            case "Notes":
              $('#ReplacedContent').html(ItineraryDetail.Notes);
              break;
            case "Cost":
              $('#ReplacedContent').html(ItineraryDetail.Cost);
              break;
            case "CoverLetter":
              $('#ReplacedContent').html(ItineraryDetail.CoverLetter);
              break;
            case "Flight":
              $('#ReplacedContent').html(ItineraryDetail.Flight);
              break;
            case "Specialists":
              $('#ReplacedContent').html(ItineraryDetail.Specialists);
              break;
            case "TourLeader":
              $('#ReplacedContent').html(ItineraryDetail.TourLeader);
              break;
            case "QuickItinerary":
              $('#ReplacedContent').html(ItineraryDetail.QuickItinerary);
              break;
            case "TourHighLights":
              $('#ReplacedContent').html(ItineraryDetail.TourHighLights);
              break;
          }

          $('.hdsgnpg_rtnvlst').find('li').each(function () {
            $(this).removeClass('cur');
          });
          $("#" + view + "Tab").parent().addClass('cur');

          $('#ddlListTab').find('option').each(function () {
            $(this).removeClass('selected');
          });
          $("#ddl" + view).addClass('selected');
          myAccountCommon.ToggleItinDetils();
        }).catch(function (err) {
        });
      }
    }
    catch (ex) {
      $("#ItinImageReplacedContent").hide();
      $('.viewall_btnblk').hide();
    }
  }

  this.ActualViewName = function (view) {
    switch (view) {
      case "Itinerary":
        return "Itinerary";
        break;
      case "Accommodation":
        return "Accommodation"
        break;
      case "Notes":
        return "Notes"
        break;
      case "ItineraryAtAGlance":
        return "Itinerary in brief"
        break;
      case "Cost":
        return "Cost"
        break;
      case "CoverLetter":
        return "Cover Letter";
        break;
      case "Flight":
        return "Flight";
        break;
      case "Specialists":
        return "Specialists";
        break;
      case "TourLeader":
        return "Tour Leader";
        break;
      case "QuickItinerary":
        return "QuickItinerary";
        break;
      case "TourHighLights":
        return "TourHighLights";
        break;
      case "JoiningInfo":
        return "Joining Information";
        break;
      case "Extension":
        return "Extension";
        break;
      case "Map":
        return "Map";
        break;
      default:
        return view;
    }
  }

  this.ReplacedViewContentOnMenuSelect = function (view, itineraryNo, callBackFunc) {
    try {
      var val = ($("#hdnShowOneStopDestinationsInd").val() || "").toString().toLowerCase();
      if (view == "Overview" || view == "HIOverview" || val == "true") {
        $(".common_header_blk").hide();  //itin intro on other pages
        $("#OverViewHeader").html('').hide();   //intor on banner on overview page
        $("#ItineraryHeader").html('').hide();
        $(".divider_line").hide();
        $("#ReplacedContent").addClass('overview_loader');
      }
      else {
        $(".common_header_blk").show();
        $("#OverViewHeader").hide();
        $("#ItineraryHeader").hide();//intor on banner on overview page
        $(".divider_line").show();
        $("#ReplacedContent").removeClass('overview_loader');
      }

      var mmMenu = $("#tripMenu").data("mmenu");
      if (mmMenu) {
        mmMenu.close();
      }
      var menuNameforSmallScreen;
      switch (view) {
        case "Cost":
          menuNameforSmallScreen = "Pricing";
          break;
        case "Overview":
          menuNameforSmallScreen = "Overview";
          break;
        case "Fullitinerary":
          menuNameforSmallScreen = "Full Itinerary";
          break;
        case "Accommodations":
          menuNameforSmallScreen = "Accommodation";
          break;
        case "Map":
          menuNameforSmallScreen = "Map";
          break;
        case "Flights":
          menuNameforSmallScreen = "Flights";
          break;
        case "Information":
          menuNameforSmallScreen = "Important Information";
          break;
        case "HIFullitinerary":
          menuNameforSmallScreen = "HIFullitinerary";
          break;
        case "HIOverview":
          menuNameforSmallScreen = "HIOverview";
          break;
        case "HIAccommodations":
          menuNameforSmallScreen = "HIAccommodations";
          break;
        case "HIFlight":
          menuNameforSmallScreen = "HIFlight";
          break;
        case "HIMap":
          menuNameforSmallScreen = "HIMap";
          break;

        
      }

      $(".page_title").text(menuNameforSmallScreen)

      var ajaxData = view == "Itinerary" ? { id: itineraryNo } : { ItineraryNo: itineraryNo };

      $(".myacc_linklst_04").find("li").each(function () {
        $(this).removeClass("cur");
      });
      $("." + view).addClass("cur");

      if (view != "Itinerary") {
        $.ajax({
          cache: false,
          async: true,
          url: hostURL + "Itinerary/" + view + "Detail",
          data: {  //     ajaxData,
            ItineraryNo: itineraryNo
          },
          beforeSend: function () {

            $("#ReplacedContent").html('');
            $('#ReplacedContent').html('<div class="loader_icon" style="background-image: url(' + hostURL + 'Content/BR/Images/UK/loader.svg); width: 100%; height: 200px; background-repeat: no-repeat; background-position: center;"></div>');
            $('html,body').animate({ scrollTop: $("#ReplacedContent").offset().top - 150 }, 'slow');
          },
          success: function (resultJson) {
            //var mmMenu = $("#tripMenu").data("mmenu");
            //if (mmMenu) {
            //  mmMenu.close();
            //}
            //if ($("#tripMenu.mm-menu_opened").length > 0)
            //{
            //  $(".menuIcon").addClass("menu_opened");
            //}
            //else
            //{
            //  $(".menuIcon").addClass("menu_closed");
            //}
            // $('.itin_hdr_panel').find(".menuIcon").toggleClass("menu_opened menu_closed");
            $('.itin_hdr_panel').find(".menuIcon").removeClass("menu_opened");
            $('.itin_hdr_panel').find(".menuIcon").addClass("menu_closed");
            $('.viewall_btnblk').hide();
            $("#ItinImageReplacedContent").hide();
            $("#ReplacedContent").removeClass('overview_loader');
            $('#ReplacedContent').show();
            $('#ReplacedContent').html(resultJson);
            $('html,body').animate({ scrollTop: $("#ReplacedContent").offset().top - 150 }, 'slow');
            $('.hdsgnpg_rtnvlst').find('li').each(function () {
              $(this).removeClass('cur');
            });

            if (callBackFunc) {
              callBackFunc();
            }
          },
          error: function (msg) {
            $('#ReplacedContent').html('<center><p>' + MyAccountConstants.GenericErrorMsg + '</p></center>');
            $("#ItinImageReplacedContent").hide();
            $('.viewall_btnblk').hide();
          }
        });
      }
      else {
        location.reload(true);
      }
    }
    catch (ex) {
      $("#ItinImageReplacedContent").hide();
      $('.viewall_btnblk').hide();
    }
  }

  this.ChangeImpInfoMenu = function (view, itineraryNo, callbackFunc) {
    $(".impmenu").each(function () {
      $(this).removeClass("active")
    });

    $("." + view).addClass("active");
    $.ajax({
      cache: false,
      async: true,
      url: hostURL + "Itinerary/InformationDetail",
      data: { ItineraryNo: itineraryNo, tabname: view },
      beforeSend: function () {
        $('#ReplacedImpInfo').html('<div style="background-image: url(' + hostURL + 'Content/BR/Images/UK/loader.svg); width: 100%; height: 200px; background-repeat: no-repeat; background-position: center;"></div>');
      },
      success: function (resultJson) {
        $("#ItinImageReplacedContent").hide();
        $('#ReplacedImpInfo').html('');
        $('#ReplacedImpInfo').show();
        $('#ReplacedImpInfo').html(resultJson);
        $('html,body').animate({ scrollTop: $("#ReplacedImpInfo").offset().top - 150 }, 'slow');
        if (callbackFunc) {
          callbackFunc();
        }
      },
      error: function (msg) {
        $('#ReplacedImpInfo').html('<center><p>' + MyAccountConstants.GenericErrorMsg + '</p></center>');
      }
    });
  }

  this.ReplacedViewContentForMobile = function (view, itineraryNo) {
    try {
      if (view == "Itinerary") {
        $('.img_slider').addClass('main_itinerary');
      }
      else {
        $('.img_slider').removeClass('main_itinerary');
      }
      if (typeof Offline != "undefined" && Offline.state == "up") {
        $.ajax({
          cache: false,
          async: true,
          url: hostURL + "Itinerary/" + view + "ViewContent",
          data: { ItineraryNo: itineraryNo },
          beforeSend: function () {
            $('.viewall_btnblk').show();
            $("#ItinImageReplacedContent").show();
