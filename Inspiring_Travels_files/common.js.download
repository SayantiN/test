  this.SendEmailForForgotPassword = function () {
    var emailId = $("#Email").val();
    var error = "";
    if (emailId == undefined || emailId == null || emailId == '') {
      error = MyAccountConstants.PleaseEnterYourEmailAddress;
    }
    else if (!myAccountCommon.IsEmail(emailId)) {
      error = MyAccountConstants.EmailAddressInvalid;
    }
    if (error != "") {
      $(".login_error").removeClass("success");
      $(".login_error").html(error);
      $(".login_error").addClass('active error');
      $(".login_error").show();
      $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
      setTimeout(function () {
        $(".login_error").removeClass('active error');
      }, 30000
      );
      return false;
    }
    if (typeof grecaptcha != 'undefined') {
      var response = grecaptcha.getResponse();
      if (response.length == 0) {
        document.getElementById('g-recaptcha-error').innerHTML = '<span style="color:red;">This field is required.</span>';
        return false;
      }
    }
    
    try {
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "Account/ForgotPassword",
        data: {
          ClientEmail: emailId
        },
        beforeSend: function () {
          $("#forgotpasswd_preloader").show();
        },
        success: function (result) {
          $("#forgotpasswd_preloader").hide();
          $(".login_error").show();
          if (result.IsRegisterdUser) {
            if (result.Status) {
              $("#Email").val('');
              if (result.ForgotPasswordLinkSentSuccessMessage)
                $(".login_error").text(result.ForgotPasswordLinkSentSuccessMessage);
              else
                $(".login_error").text(MyAccountConstants.ForgotPasswordLinkSentSuccessMessage);
              $(".login_error").removeClass("error");
              $(".login_error").addClass("success");
              $(".login_error").addClass("active");
              setTimeout(function () {
                $(".login_error").text('');
                $(".login_error").removeClass("active");
              }, 30000);
            }
            else {
              $(".login_error").text(MyAccountConstants.ForgotPasswordLinkSentErrorMessage);
              $(".login_error").removeClass("success");
              $(".login_error").addClass("error");
              $(".login_error").addClass("active");
              $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
              setTimeout(function () {
                $(".login_error").text('');
                $(".login_error").removeClass("active");
              }, 30000);
            }
          }
          else {
            $(".login_error").text(MyAccountConstants.ForgotPasswordNotRegisteredUser);
            $(".login_error").removeClass("success");
            $(".login_error").addClass("error");
            $(".login_error").addClass("active");
            $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
            setTimeout(function () {
              $(".login_error").text('');
              $(".login_error").removeClass("active");
            }, 30000);
          }
        },
        error: function (msg) {
          $("#forgotpasswd_preloader").hide();
          if (!myAccountCommon.isNullOrEmpty($.trim(msg.responseText))) {
            if (msg.responseText.match('Error has occured') != null && msg.responseText.match('Error has occured').length > 0) {
              window.location.href = MyAccountConstants.HostUrl + 'Account/Error';
            }
            else {
              console.log(msg);
              $(".login_error").text(MyAccountConstants.GenericErrorMsg);
              $(".login_error").removeClass("success");
              $(".login_error").addClass("error");
              $(".login_error").addClass("active");
              $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
              setTimeout(function () {
                $(".login_error").text('');
                $(".login_error").removeClass("active");
              }, 30000);
            }
          }
        }
      });
      $(".login_error").text('');
    }
    catch (ex) {
      $(".login_error").text('');
      $("#forgotpasswd_preloader").hide();
      console.log(ex);
    }
  }

  this.ResetPassword = function (acctId, accessNumber) {
    var error = "";
    $("#errMsg").html("");
    $("#errMsg").hide();

    var newPswd = $("#NewPassword").val();
    var confPswd = $("#ConfirmPassword").val();

    if (typeof (newPswd) === "undefined" || newPswd == "") {
      error += "Please enter Password. </br>";
    }
    else {
      error += myAccountCommon.ValidatePassword(newPswd);
      if (error == "" && newPswd != confPswd) {
        error += "Passwords mismatch </br>";
      }
    }

    if (error != "") {
      $(".login_error").html(error);
      $(".login_error").addClass('active error');
      setTimeout(function () {
        $(".login_error").removeClass('active error');
      }, 30000);
      return false;
    }
    try {
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "account/ResetPassword",
        data: {
          Email: acctId,
          AccessNumber: accessNumber,
          NewPassword: newPswd,
          ConfirmPassword: confPswd
        },
        beforeSend: function () {
          $("#resetpasswd_preloader").show();
        },
        success: function (result) {
          $("#resetpasswd_preloader").hide();
          if (result !== "undefined" && result.Status == 0) {
            myAccountCommon.ClearProfileForm();
            $(".login_error").removeClass("error");
            $(".login_error").addClass('active success');
            if (result.PasswordUpdatedSuccessMessage)
              $(".login_error").html(result.PasswordUpdatedSuccessMessage);
            else
              $(".login_error").html(MyAccountConstants.PasswordUpdatedSuccessMessage);
          }
          else if (result !== "undefined" && result.Status == 2) {
            $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
            $(".login_error").removeClass("success");
            $(".login_error").addClass('active error');
          }
          else {
            $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
            $(".login_error").removeClass("success");
            $(".login_error").addClass('active error');
          }
          $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
          setTimeout(function () {
            $(".login_error").removeClass('active success error');
            if (result !== "undefined" && result.Status == 0)
              window.location = hostURL;
          }, 5000);
        },
        error: function (msg) {
          $("#resetpasswd_preloader").hide();
          if (!myAccountCommon.isNullOrEmpty($.trim(msg.responseText))) {
            if (msg.responseText.match('Error has occured') != null && msg.responseText.match('Error has occured').length > 0) {
              window.location.href = MyAccountConstants.HostUrl + 'Account/Error';
            }
            else {
              console.log(msg);
              $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
              $(".login_error").removeClass("success");
              $(".login_error").addClass('active error');
              $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
              setTimeout(function () {
                $(".login_error").removeClass('active error success');
              }, 30000);
            }
          }
        }
      });
    }
    catch (ex) {
      console.log(ex);
      $("#resetpasswd_preloader").hide();
      $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
      $(".login_error").removeClass("success");
      $(".login_error").addClass('active error');
      $('html,body').animate({ scrollTop: $(".login_error").offset().top - 150 }, 'slow');
      setTimeout(function () {
        $(".login_error").removeClass('active error success');
      }, 30000);
    }
  }

