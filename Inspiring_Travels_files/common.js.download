  this.Instagram = function () {
    if (instagramFeed == null) {
      instagramFeed = new Instafeed({
        get: 'user',
        userId: MyAccountConstants.SteppesInstgramUserId,
        clientId: MyAccountConstants.SteppesInstgramClientId,
        accessToken: MyAccountConstants.SteppesInstagramAccessToken,
        limit: '6',
        template:
          '<div class="col-xs-6 col-sm-4 col-md-4 col-lg-4 img01">' +
            '<a href="{{link}}" target="_blank"><img src="{{image}}" /></a>' +
            '</div>',
        links: true,
        sortBy: "none"
      });
      instagramFeed.run();
    }
  }
  this.isMobile = function () {
    if (/Android|webOS|iPhone|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent))
      return true;
    else
      return false;
  }

  this.UpdateMarketingPreferences = function (accountCode, toMail) {
    var emailId = $("#Email").val();
    var error = "";
    if (emailId == undefined || emailId == null || emailId == '') {
      error = MyAccountConstants.PleaseEnterYourEmailAddress;
    }
    else if (!myAccountCommon.IsEmail(emailId)) {
      error = MyAccountConstants.EmailAddressInvalid;
    }
    if (error != "") {
      $(".login_error").html(error);
      $(".login_error").addClass('active error');
      setTimeout(function () {
        $(".login_error").removeClass('active error');
      }, 30000
      );
      return false;
    }

    try {
      $.ajax({
        cache: false,
        type: "post",
        url: hostURL + "account/GetGDPRLink",
        data: {
          accountCode: accountCode,
          toMail: $("#Email").val()
        },

        success: function (result) {
          if (!(result == undefined || result == null || result == '')) {
            window.location = result;
          }
        },
        error: function (msg) {
          if (!myAccountCommon.isNullOrEmpty($.trim(msg.responseText))) {
            if (msg.responseText.match('Error has occured') != null && msg.responseText.match('Error has occured').length > 0) {
              myAccountCommon.RedirectToUrl('', 'Account/Error');
            }
            else {
              console.log(msg);
              $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
              $(".login_error").addClass('active error');
              setTimeout(function () {
                $(".login_error").removeClass('active error');
              }, 30000);
            }
          }
        }
      });
    }
    catch (ex) {
      console.log(ex);
      $(".login_error").html(MyAccountConstants.GenericEditProfileErrorMsg);
      $(".login_error").removeClass('success');
      $(".login_error").addClass('active error');
      setTimeout(function () {
        $(".login_error").removeClass('active error');
      }, 30000
                      );
    }
  }

  this.validatecaptcha= function()
  {
    var response = grecaptcha.getResponse();
    if (response.length == 0) {
      document.getElementById('g-recaptcha-error').innerHTML = '<span style="color:red;">This field is required.</span>';
      return false;
    }
    return true;
  }

  function verifyCaptcha() {
    document.getElementById('g-recaptcha-error').innerHTML = '';
  }
}
//for fading out  down arrow on dashboard
$(window).scroll(function () {
  if ($(".bannerScrollArrow").length) {
    //get scroll position
    var topWindow = $(window).scrollTop();
    //multipl by 1.5 so the arrow will become transparent half-way up the page
    var topWindow = topWindow * 1.5;
    //get height of window
    var windowHeight = $(window).height();
    //set position as percentage of how far the user has scrolled 
    var position = topWindow / windowHeight;
    //invert the percentage
    position = 1 - position;
    //define arrow opacity as based on how far up the page the user has scrolled
    //no scrolling = 1, half-way up the page = 0
    $('.bannerScrollArrow').css('opacity', position);
  }
});

