                $("#dvCostEr").text(MyAccountConstants.CostEnquiryRequestErrorMessage);
                $("#dvCostEr").addClass("error");
                $("#dvCostEr").show();
                setTimeout(function () {
                  $("#dvCostEr").hide();
                }, 30000);
              }
            }
          }
        },
        error: function (msg) {
          if (!myAccountCommon.isNullOrEmpty($.trim(msg.responseText))) {
            if (msg.responseText.match('Error has occured') != null && msg.responseText.match('Error has occured').length > 0) {
              window.location.href = MyAccountConstants.HostUrl + 'Account/Error';
