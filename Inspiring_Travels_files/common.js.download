  this.ResetGiftSelection = function () {
    $("#divLoyaltyCatg").find(".catg_type").each(function () {
      $(this).find(".prdct_slct .checked").each(function () {
        $(this).removeClass("checked");
        $(this).parent().parent().removeClass("checked")
      });
    });
  }

  this.ParseJsonDateToDateTime = function (jsonDate) {
    if (jsonDate != null && jsonDate != undefined && jsonDate != "") {
      if (jsonDate.toString().indexOf("Date") > 0)
        //return $.datepicker.formatDate('dd/mm/yy', new Date(parseInt(jsonDate.substr(6))));
        return new Date(parseInt(jsonDate.substr(6)));
      else
        return jsonDate;
    }
    else
      return null;
  }

  this.AppendZero = function (date) {

    if (date != undefined && date != '') {

      if (parseInt(date) >= 10) {
        return date;
      }
      else {
        return "0" + date;
      }
    }
  }

  this.RedirectToUrl = function (event, url) {
    if (typeof (url) !== 'undefined' && url != '' && url != "javascript:void(0)") {
      //event.preventDefault();  //stop the browser from following
      window.location.href = url;
    }
  }

