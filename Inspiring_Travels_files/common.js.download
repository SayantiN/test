          menuDiv.removeClass('open');
          $('.nav_lnk.menu.cur').removeClass('cur');
          event.stopPropagation();
          return;
        }
      }
      if (typeof openedMenu === undefined || openedMenu.length <= 0) {
        menuDiv.addClass('open');
        $(curMenu).addClass('cur');
        $(".subnav_wrp.open").bind(hitEvent, function (event) {
          event.stopPropagation();
        })
      }
      else {
        $('.subnav_wrp').removeClass('open');
        $('.nav_lnk.menu.cur').removeClass('cur');
        setTimeout(function () {
          menuDiv.addClass('open');
          $(curMenu).addClass('cur');
          $(".subnav_wrp.open").bind(hitEvent, function (event) {
            event.stopPropagation();
          })
        }, 500);
      }
      event.stopPropagation();
